digraph G {graph[label="MercadoClick — Diagrama de secuencia: realizar compra",labelloc=t,fontsize=18,fontname="DejaVu Sans",ranksep=0.32,nodesep=0.3];node[fontname="DejaVu Sans",fontsize=11];edge[fontname="DejaVu Sans",fontsize=10];start[shape=record,label="{ :Cliente | :SistemaDeVentas | :ServicioDePagos }",style=filled,fillcolor="#E9F2FA"]; s1[shape=box,label="1. Cliente → SistemaDeVentas: solicitarFinalizarCompra()",style=rounded];s2[shape=box,label="2. SistemaDeVentas → SistemaDeVentas: calcularTotal()",style=rounded];s3[shape=box,label="3. Cliente → SistemaDeVentas: seleccionarMedioPago(metodoPago)",style=rounded];s4[shape=box,label="4. SistemaDeVentas → ServicioDePagos: solicitarAutorizacion(monto, token)",style=rounded];s5[shape=box,label="5. ServicioDePagos → SistemaDeVentas: informarResultadoAutorizacion(estado)",style=rounded];s6[shape=box,label="6. SistemaDeVentas → Cliente: notificarPedidoExitoso() [si aprobado]",style=rounded];start->s1->s2->s3->s4->s5->s6;}