digraph G {graph[label="MercadoClick — Diagrama de comunicación: realizar compra",labelloc=t,fontsize=18,fontname="DejaVu Sans",splines=polyline,ranksep=1.4,nodesep=1.1];node[shape=box,style="rounded,filled",fillcolor="#E9F2FA",fontname="DejaVu Sans",fontsize=13,margin=0.25];edge[fontname="DejaVu Sans",fontsize=10,color="#334E68"];cliente[label=":Cliente"];ventas[label=":SistemaDeVentas"];pagos[label=":ServicioDePagos"];{rank=same;cliente;ventas;}cliente->ventas[label="1: solicitarFinalizarCompra()\n3: seleccionarMedioPago(metodoPago)",minlen=2];ventas->ventas[label="2: calcularTotal()",color="#6D28D9"];ventas->pagos[label="4: solicitarAutorizacion(monto, token)",minlen=2];pagos->ventas[label="5: informarResultadoAutorizacion(estado)",constraint=false,color="#B45309"]; }