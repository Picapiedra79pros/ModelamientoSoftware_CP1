digraph G {graph [label="Sistema MercadoClick — Diagrama de casos de uso",labelloc=t,fontsize=19,fontname="DejaVu Sans",ranksep=0.5,nodesep=0.45];node[fontname="DejaVu Sans",fontsize=10];edge[fontname="DejaVu Sans",fontsize=9,dir=none]; cliente[shape=plaintext,label="Cliente"]; inventario[shape=plaintext,label="Trabajador de inventario"]; preparador[shape=plaintext,label="Preparador de pedidos"]; repartidor[shape=plaintext,label="Repartidor"]; pasarela[shape=plaintext,label="Pasarela de pagos externa"];subgraph cluster_s {label="MercadoClick";style=rounded;color="#486581"; node[shape=ellipse,style=filled,fillcolor="#E9F2FA"]; catalogo[label="Consultar catálogo"];buscar[label="Buscar productos"];login[label="Iniciar sesión"];carrito[label="Gestionar carrito"];pedido[label="Realizar pedido"];cupon[label="Aplicar cupón"];estado[label="Consultar estado de pedido"];actualizar[label="Actualizar inventario"];preparar[label="Preparar pedido"];entrega[label="Realizar entrega"];verificar[label="Verificar disponibilidad"];pago[label="Procesar pago"]; } cliente->catalogo;cliente->buscar;cliente->login;cliente->carrito;cliente->pedido;cliente->estado;inventario->actualizar;preparador->preparar;repartidor->entrega;pasarela->pago;pedido->verificar[style=dashed,dir=forward,label="«include»"];pedido->pago[style=dashed,dir=forward,label="«include»*"];cupon->pedido[style=dashed,dir=forward,label="«extend»"]; }